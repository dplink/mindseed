# ============================================================
# MindSeed · 实例配置
# 首次唤醒时由 AI 与用户共同填写。所有脚本都从这里读取，禁止把仓库名写死在脚本里。
# 未填写的值保持 __XXX__ 形式；wake 会据此判断「尚未实例化」。
# ============================================================

# 心智库仓库（owner/repo），用于 wake 的 clone / pull / push
REPO_SLUG=__OWNER__/__REPO__

# 人格与用户
PERSONA_NAME=__PERSONA__
PERSONA_ROLE=__ROLE__
USER_NAME=__USER__
USER_ALIAS=用户

# 可选：图床双仓（0=不启用；1=启用）
VISION_ENABLED=0
VISION_REPO_SLUG=

# 时区（仅用于报告与日期提示）
TIMEZONE=Asia/Shanghai
